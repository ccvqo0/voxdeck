<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:VoxDeck.Core" xmlns:v="using:VoxDeck.Views" xmlns:vm="using:VoxDeck.ViewModels"
        x:Class="VoxDeck.Views.MiniPadWindow"
        Title="VoxDeck Soundpad" Width="388" Height="400" MinWidth="260" MinHeight="200" FontSize="13"
        SystemDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual">
  <Border Margin="6" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
          Opacity="{Binding Set.MiniOpacity01}" ClipToBounds="True">
    <DockPanel>
      <Grid DockPanel.Dock="Top" x:Name="Header" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="Transparent" Margin="12,8,6,6">
        <TextBlock Classes="icon" Text="{x:Static l:Ic.Grid2x2}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{l:T mini.pad}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <v:Visualizer Width="44" Height="14" Bars="9" VerticalAlignment="Center" />
        </StackPanel>
        <Slider Grid.Column="2" Width="70" Minimum="25" Maximum="100" Value="{Binding Set.MiniOpacity}" ToolTip.Tip="{l:T mini.opacity}" VerticalAlignment="Center" />
        <Button Grid.Column="3" Classes="icon sm" Margin="6,0,0,0" Command="{Binding Pad.StopAllCommand}" ToolTip.Tip="{l:T stop}"><TextBlock Classes="icon" Text="{x:Static l:Ic.Square}" Foreground="{DynamicResource DangerBrush}" /></Button>
        <Button Grid.Column="4" x:Name="CloseBtn" Classes="icon sm"><TextBlock Classes="icon" Text="{x:Static l:Ic.X}" /></Button>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Classes="sub" Text="{l:T mini.pad.hint}" FontSize="11" Margin="14,4,14,9" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,2,0">
        <ItemsControl ItemsSource="{Binding Pad.MiniItems}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="tile" Classes.playing="{Binding IsPlaying}" Width="112" Height="62" Margin="0,0,7,7" Command="{Binding Pad.PlayCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}" Focusable="False">
                <Border Classes="face" CornerRadius="{DynamicResource TileRadius}" ClipToBounds="True">
                  <Panel>
                    <Border Width="3" HorizontalAlignment="Left" Background="{Binding Brush}" />
                    <TextBlock Classes="name" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Margin="9,0,6,0" />
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom" IsVisible="{Binding IsLoading}" Background="Transparent" />
                    <Border Classes="ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource TileRadius}" IsHitTestVisible="False" />
                  </Panel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
