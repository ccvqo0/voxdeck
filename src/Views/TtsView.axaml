<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:VoxDeck.Core" xmlns:v="using:VoxDeck.Views"
             x:Class="VoxDeck.Views.TtsView">
  <Grid ColumnDefinitions="*,12,372">
    <!-- left -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,2,0">
        <StackPanel Margin="6,4,0,2">
          <TextBlock Classes="h1" Text="{l:T tts.title}" />
          <TextBlock Classes="sub" Text="{l:T tts.sub}" />
        </StackPanel>

        <Border Classes="card" Padding="0" ClipToBounds="True">
          <StackPanel>
            <TextBox x:Name="Input" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="260"
                     Watermark="{l:T tts.placeholder}" BorderThickness="0" Background="Transparent" Padding="18,16" FontSize="15" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="18,0" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,8,14,14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding SpeakCommand}" ToolTip.Tip="{l:T tts.play.tip}" HotKey="Ctrl+Enter">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="{x:Static l:Ic.Send}" FontSize="15" />
                    <TextBlock Text="{l:T play}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding PreviewCommand}" ToolTip.Tip="{l:T tts.preview.tip}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="{x:Static l:Ic.Headphones}" FontSize="15" />
                    <TextBlock Text="{l:T preview}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding DownloadCommand}" ToolTip.Tip="{l:T tts.download.tip}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="{x:Static l:Ic.Download}" FontSize="15" />
                    <TextBlock Text="{l:T download}" />
                  </StackPanel>
                </Button>
                <Button Classes="icon" Command="{Binding StopCommand}" ToolTip.Tip="{l:T stop}">
                  <TextBlock Classes="icon" Text="{x:Static l:Ic.Square}" FontSize="14" />
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="sub" VerticalAlignment="Center" Margin="0,0,6,0">
                  <Run Text="{Binding CharCount}" /><Run Text=" " /><Run Text="{l:T chars}" />
                </TextBlock>
                <Button Classes="icon" Command="{Binding ClearTextCommand}" ToolTip.Tip="{l:T clear}">
                  <TextBlock Classes="icon" Text="{x:Static l:Ic.Trash2}" FontSize="14" />
                </Button>
                <Button Classes="icon" x:Name="PinBtn" ToolTip.Tip="{l:T pin.tip}">
                  <TextBlock Classes="icon" Text="{x:Static l:Ic.Pin}" FontSize="15" />
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="{x:Static l:Ic.SlidersHorizontal}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Classes="h2" Text="{l:T tts.settings}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Grid.Column="2" Classes="pill">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="{x:Static l:Ic.User}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                  <TextBlock Text="{Binding SelectedVoiceText}" FontSize="12" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,18,*,18,*">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T tts.rate}" /><TextBlock Grid.Column="1" Classes="val" Text="{Binding RateText}" /></Grid>
                <Slider Minimum="-50" Maximum="100" Value="{Binding Rate}" TickFrequency="5" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T tts.pitch}" /><TextBlock Grid.Column="1" Classes="val" Text="{Binding PitchText}" /></Grid>
                <Slider Minimum="-12" Maximum="12" Value="{Binding Pitch}" TickFrequency="0.5" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="6">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T tts.volume}" /><TextBlock Grid.Column="1" Classes="val" Text="{Binding VolumeText}" /></Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" TickFrequency="1" IsSnapToTickEnabled="True" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,18,Auto">
              <StackPanel Spacing="6">
                <TextBlock Text="{l:T tts.effect}" />
                <ComboBox ItemsSource="{Binding FxList}" SelectedItem="{Binding SelectedFx}" MaxDropDownHeight="420">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Classes="icon" Text="{Binding Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CatName}" Classes="sub" VerticalAlignment="Center" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Bottom" Padding="10,8" Command="{Binding ResetVoiceCommand}" ToolTip.Tip="{l:T tts.reset.tip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Classes="icon" Text="{x:Static l:Ic.Undo2}" FontSize="14" />
                  <TextBlock Text="{l:T tts.reset}" FontSize="13" />
                </StackPanel>
              </Button>
            </Grid>
            <Border Height="1" Background="{DynamicResource StrokeSoftBrush}" Margin="0,2" />
            <v:FitWrapPanel MinItemWidth="250">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,18,8" ToolTip.Tip="{l:T tts.clarity.tip}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T tts.clarity}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="sub" Text="{l:T tts.clarity.sub}" FontSize="12" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Clarity}" Margin="8,0,0,0" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,18,8" ToolTip.Tip="{l:T tts.balance.tip}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T tts.balance}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="sub" Text="{l:T tts.balance.sub}" FontSize="12" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoBalance}" Margin="8,0,0,0" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,18,8">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T tts.clearafter}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="sub" Text="{l:T tts.clearafter.sub}" FontSize="12" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClearAfter}" Margin="8,0,0,0" />
              </Grid>
            </v:FitWrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasHistory}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="{x:Static l:Ic.History}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Classes="h2" Text="{l:T tts.history}" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost" Padding="8,4" Command="{Binding ClearHistoryCommand}">
                <TextBlock Classes="sub" Text="{l:T clear}" />
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="chip" Command="{Binding $parent[ItemsControl].DataContext.UseHistoryCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding}" MaxWidth="260" TextTrimming="CharacterEllipsis" FontSize="13" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- right: voices -->
    <Border Grid.Column="2" Classes="card" Padding="14,14,8,10">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="2,0,6,10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" Text="{x:Static l:Ic.AudioLines}" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Classes="h2" Text="{l:T tts.voices}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="2" Classes="sub" Text="{Binding VoiceCount}" VerticalAlignment="Center" />
        </Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,6,Auto" Margin="0,0,6,8">
          <TextBox Text="{Binding Search}" Watermark="{l:T tts.search}">
            <TextBox.InnerLeftContent>
              <TextBlock Classes="icon" Text="{x:Static l:Ic.Search}" FontSize="14" Margin="10,0,-4,0" Foreground="{DynamicResource SubTextBrush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ToggleButton Grid.Column="2" Classes="icon" IsChecked="{Binding FavOnly}" ToolTip.Tip="{l:T fav.only}" Width="36" Height="36">
            <TextBlock Classes="icon" Text="{x:Static l:Ic.Star}" FontSize="15" />
          </ToggleButton>
        </Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,6,128" Margin="0,0,6,8">
          <ComboBox ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}" MaxDropDownHeight="420" />
          <ComboBox Grid.Column="2" SelectedIndex="{Binding GenderIndex}">
            <ComboBoxItem Content="{l:T gender.all}" />
            <ComboBoxItem Content="{l:T female}" />
            <ComboBoxItem Content="{l:T male}" />
          </ComboBox>
        </Grid>
        <ListBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent">
                <Border Width="34" Height="26" CornerRadius="5" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1" Margin="0,0,10,0">
                  <TextBlock Text="{Binding Code}" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="sub" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Locale}" /><Run Text=" · " /><Run Text="{Binding GenderText}" /><Run Text=" · " /><Run Text="{Binding EngineText}" />
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Classes="icon sm" Command="{Binding $parent[ListBox].DataContext.PreviewVoiceCommand}" CommandParameter="{Binding}" ToolTip.Tip="{l:T voice.sample}">
                  <Panel>
                    <TextBlock Classes="icon" Text="{x:Static l:Ic.Play}" IsVisible="{Binding !IsBusy}" />
                    <TextBlock Classes="icon spin" Text="{x:Static l:Ic.LoaderCircle}" IsVisible="{Binding IsBusy}" />
                  </Panel>
                </Button>
                <Button Grid.Column="3" Classes="icon sm" Command="{Binding $parent[ListBox].DataContext.ToggleFavCommand}" CommandParameter="{Binding}" ToolTip.Tip="{l:T fav}">
                  <Panel>
                    <TextBlock Classes="icon" Text="{x:Static l:Ic.Star}" Foreground="{DynamicResource SubTextBrush}" IsVisible="{Binding !IsFav}" />
                    <TextBlock Classes="icon" Text="{x:Static l:Ic.Star}" Foreground="#FFC83D" IsVisible="{Binding IsFav}" />
                  </Panel>
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
