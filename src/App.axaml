<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoxDeck.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <FontFamily x:Key="UiFont">Segoe UI, fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="Icons">avares://VoxDeck/Assets/lucide.ttf#lucide</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://VoxDeck/Styles.axaml" />
  </Application.Styles>
</Application>
