<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Typography ===== -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.icon">
    <Setter Property="FontFamily" Value="{StaticResource Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.cap">
    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.val">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CtlRadius}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PillRadius}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- ===== Pages (enter animation) ===== -->
  <Style Selector=":is(UserControl).page">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(UserControl).page.active">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector=":is(UserControl).page.noanim">
    <Setter Property="Transitions"><Transitions /></Setter>
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CtlRadius}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Button:focus-visible, ToggleButton:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- primary -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentGradBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,9" />
  </Style>
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentGradBrush}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- danger -->
  <Style Selector="Button.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ghost / icon -->
  <Style Selector="Button.ghost, ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon.sm, ToggleButton.icon.sm">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Button.icon.sm TextBlock.icon">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton:checked TextBlock.icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- nav -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.nav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
  </Style>
  <Style Selector="Button.nav:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock.icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.nav Border.ind">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scaleY(0.2)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav.active Border.ind">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scaleY(1)" />
  </Style>

  <!-- chips -->
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="{DynamicResource PillRadius}" />
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
  </Style>
  <Style Selector="Button.chip.sel /template/ ContentPresenter#PART_ContentPresenter, Button.chip.sel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentGradBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.chip.sel TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- sound tiles -->
  <Style Selector="Button.tile">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource TileRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tile Border.face">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.tile:pointerover Border.face">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
  </Style>
  <Style Selector="Button.tile TextBlock.meta">
    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
  </Style>
  <Style Selector="Button.tile.img TextBlock.name">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.tile.img TextBlock.meta">
    <Setter Property="Foreground" Value="#D0FFFFFF" />
  </Style>
  <Style Selector="Button.tile StackPanel.actions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tile:pointerover StackPanel.actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.tile Border.ring">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tile.playing Border.ring">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.tile.playing Border.ring">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.mini">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SolidBgBrush}" />
  </Style>
  <Style Selector="Button.mini /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SolidBgBrush}" />
  </Style>
  <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Button.mini TextBlock.icon">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.mini.on TextBlock.icon">
    <Setter Property="Foreground" Value="#FFC83D" />
  </Style>

  <!-- preset tiles -->
  <Style Selector="Button.preset">
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="84" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource TileRadius}" />
  </Style>
  <Style Selector="Button.preset.sel /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- theme tiles -->
  <Style Selector="Button.theme">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.theme /template/ ContentPresenter#PART_ContentPresenter, Button.theme:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.theme:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.theme Border.sel">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions></Setter>
  </Style>
  <Style Selector="Button.theme.sel Border.sel">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource CtlRadius}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource CtlRadius}" />
    <Setter Property="Padding" Value="12,7,6,7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Margin" Value="0,-6" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="ProgressBar.meter">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource AccentGradBrush}" />
  </Style>

  <!-- ===== Lists ===== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CtlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource PopupBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- ===== Ambient blobs ===== -->
  <Style Selector="Panel.anim Ellipse.b1">
    <Style.Animations>
      <Animation Duration="0:0:19" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="190" /><Setter Property="TranslateTransform.Y" Value="110" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Panel.anim Ellipse.b2">
    <Style.Animations>
      <Animation Duration="0:0:23" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="-220" /><Setter Property="TranslateTransform.Y" Value="-130" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Panel.anim Ellipse.b3">
    <Style.Animations>
      <Animation Duration="0:0:27" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="-140" /><Setter Property="TranslateTransform.Y" Value="160" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- island -->
  <Style Selector="Border.island">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PillRadius}" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.island.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.island.error">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.spin">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
